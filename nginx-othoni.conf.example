# Example nginx site for othoni: reverse proxy, then HTTPS via certbot.
#
# install.sh does all of this for you — it asks during guided setup, or
# re-run it on an existing install with:
#     sudo OTHONI_SETUP_TLS=1 bash /var/www/othoni/install.sh
#
# To do it by hand:
#   1. Point a DNS A/AAAA record for your hostname at this server, and allow
#      ports 80 + 443 through any firewall (ufw, your cloud's security group).
#   2. sudo apt install nginx certbot python3-certbot-nginx
#   3. Copy this file to /etc/nginx/sites-available/othoni and symlink it into
#      /etc/nginx/sites-enabled/ (or to /etc/nginx/conf.d/othoni.conf on
#      RHEL-family distros), replacing othoni.example.com with your hostname.
#   4. sudo nginx -t && sudo systemctl reload nginx
#   5. sudo certbot --nginx -d othoni.example.com --redirect
#      certbot gets the certificate and edits this file: it adds the 443
#      listener, the certificate paths and an http → https redirect, and
#      sets up automatic renewal.
#
# The file starts out plain-HTTP on purpose: a server block naming
# certificate files that don't exist yet fails `nginx -t`, and certbot needs
# a working nginx to get the certificate in the first place.
#
# othoni runs with `app.set('trust proxy', 1)`, so the X-Forwarded-* headers
# below are honored by express-rate-limit and the secure-cookie logic.

server {
    listen 80;
    listen [::]:80;
    server_name othoni.example.com;

    # The dashboard never serves user uploads. 1 MB is more than enough for
    # the largest expected POST (an /api/metrics batch capped at 256 KB).
    client_max_body_size 1m;

    # Reasonable defaults for an internal monitoring app — never cache the SPA
    # shell or the JSON API. Vite-built static asset paths are content-hashed,
    # so the dashboard auto-refreshes without surprise stale content.
    add_header Cache-Control "no-store" always;

    # Don't expose the upstream banner to the world.
    server_tokens off;

    location / {
        proxy_pass         http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 60s;
    }
}
